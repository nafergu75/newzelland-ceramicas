# Copiar como .env. Este servicio es un proceso Node persistente (NO Vercel)
# — se despliega en Railway/Render/Fly.io o un VPS con Docker.

# --- Postgres: LA MISMA base de datos que usa api/index.js ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# --- IA (Anthropic Claude — generación de respuestas + tool use) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Embeddings para RAG (Voyage AI, recomendado oficialmente por Anthropic) ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# --- CRM (Brevo) — reutiliza api/services/crmService.js, mismas variables ---
CRM_ENABLED=false
CRM_PROVIDER=brevo
CRM_API_KEY=
CRM_BASE_URL=https://api.brevo.com/v3
CRM_LIST_ID=
CRM_SENDER_EMAIL=info@newzelland.es
CRM_SENDER_NAME=Newzeland Cerámicas

# --- Web (para enlaces en respuestas: presupuesto, proyectos, etc.) ---
FRONTEND_URL=https://newzelland-ceramicas.vercel.app

# --- Notificación de handoff a humano ---
# Email donde llega un aviso cuando una conversación pasa a "esperando_humano"
ADMIN_NOTIFY_EMAIL=info@newzelland.es

# --- Sesión de WhatsApp ---
# Carpeta donde whatsapp-web.js guarda la sesión autenticada (LocalAuth).
# En Railway/Render, montar esto como volumen persistente o la sesión se
# pierde en cada redeploy y hay que re-escanear el QR.
WHATSAPP_SESSION_PATH=./.wwebjs_auth
