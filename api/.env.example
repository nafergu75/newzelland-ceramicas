# Copiar como .env (o .env.local) y rellenar. NUNCA commitear el .env real.

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# OBLIGATORIA en todos los entornos: firma y valida las sesiones (incluida la
# de administración). Cadena aleatoria de 32 caracteres como mínimo; el API se
# niega a arrancar si falta o es más corta. No la subas a GitHub ni la escribas
# en ningún fichero versionado. Al cambiarla, los tokens ya emitidos dejan de
# ser válidos y todo el mundo tiene que volver a iniciar sesión.
# Generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sustituir-por-una-cadena-aleatoria-de-32-caracteres-o-mas

FRONTEND_URL=
NODE_ENV=development

# --- Cloudflare R2 (URLs firmadas para /api/catalogs/download) ---
# Si se dejan vacías, el endpoint sigue funcionando con la URL pública
# actual de catalog-fichas.json (comportamiento de hoy). Se activan
# solo cuando las 4 están presentes.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- CRM / Email marketing (E3) ---
# Si CRM_ENABLED no es exactamente "true", todas las llamadas al CRM se
# omiten en silencio (no rompe registro/descargas/formularios aunque no
# haya cuenta de Brevo configurada).
CRM_ENABLED=false
CRM_PROVIDER=brevo
CRM_API_KEY=
CRM_BASE_URL=https://api.brevo.com/v3
CRM_LIST_ID=
CRM_SENDER_EMAIL=info@newzelland.es
CRM_SENDER_NAME=Newzeland Cerámicas
